# Canvass (Pitch HQ + Lead Finder)
AddType application/manifest+json .webmanifest
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # never serve the code library, the data folder, databases or backups
  RewriteRule ^(lib|data|tests)(/|$) - [F,L]
  RewriteRule \.(sqlite|sqlite-wal|sqlite-shm|db|zip|bak|md|json)$ - [F,L]
</IfModule>

<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|db|bak|md|ini)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000"
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
